@startuml

top to bottom direction

state "Boot (GAME_STATE_BOOT)" as Boot {
    state "Initialisierung\n(SENSOR_STATE_INIT)" as BootInit
    state "Kalibrierung\n(SENSOR_STATE_CALIBRATING)" as BootCalib

    [*] -right-> BootInit
    BootInit -right-> BootCalib : Hardware OK
}

[*] --> Boot
Boot --> ModeCount : Kalibriert (ARMED)

state "Spiel" as Spiel {
    state "Modus Zählen (GAME_MODE_COUNT)" as ModeCount {
        state "Bereit (GAME_STATE_READY)" as ModeCountReady
        state "Aktiv (GAME_STATE_RUNNING)" as ModeCountActive

        [*] -right-> ModeCountReady

        ModeCountReady -right-> ModeCountActive : HIT
        ModeCountActive -left-> ModeCountReady : RIGHT (Reset Counter)
    }
    state "Modus Zeit (GAME_MODE_TIMED)" as ModeTimed {
        state "Bereit (GAME_STATE_READY)" as ModeTimedReady
        state "Aktiv (GAME_STATE_RUNNING)" as ModeTimedActive
        state "Resultat (GAME_STATE_FINISHED)" as ModeTimedResult

        [*] -right-> ModeTimedReady

        ModeTimedReady -right-> ModeTimedActive : HIT
        ModeTimedActive -left-> ModeTimedReady : RIGHT (Restart)
        ModeTimedActive -down-> ModeTimedResult : TIME_LIMIT
        ModeTimedResult --> ModeTimedReady : RIGHT (Restart)

        ModeTimedReady --> ModeTimedReady : UP/DOWN (Zeit +/-5s)
    }
    state "Modus Rennen (GAME_MODE_RACE)" as ModeRace {
        state "Bereit (GAME_STATE_READY)" as ModeRaceReady
        state "Aktiv (GAME_STATE_RUNNING)" as ModeRaceActive
        state "Resultat (GAME_STATE_FINISHED)" as ModeRaceResult

        [*] -right-> ModeRaceReady

        ModeRaceReady -right-> ModeRaceActive : HIT
        ModeRaceActive -left-> ModeRaceReady : RIGHT (Restart)
        ModeRaceActive -down-> ModeRaceResult : TARGET_REACHED
        ModeRaceResult --> ModeRaceReady : RIGHT (Restart)

        ModeRaceReady --> ModeRaceReady : UP/DOWN (Anzahl Schläge +/-5)
    }

    ModeCount -[hidden]down-> ModeTimed
    ModeTimed -[hidden]down-> ModeRace
}

state "Analyse-Aufnahme (GAME_STATE_CAPTURING)" as Capturing {
    state "Scharf\n(SENSOR_STATE_CAPTURE_ARMED)" as CapturingArmed
    state "Aufnahme\n(SENSOR_STATE_CAPTURING)" as CapturingRecord
    state "Übertragung\n(SENSOR_STATE_CAPTURE_TX_WAIT)" as CapturingStream

    [*] --> CapturingArmed
    CapturingArmed -> CapturingRecord : Schlag/Trigger
    CapturingRecord --> CapturingStream : Puffer voll (21'000 Samples)
}
note bottom of Capturing: Hinweis: Erfassung (GAME_STATE_CAPTURING) wird extern via\nCompanion (CMD_CAPTURE) gesteuert (Übergänge hier nicht dargestellt).

state "Menü (GAME_STATE_MENU)" as Menu {
    state "Modus Zählen\n(GAME_MODE_COUNT)" as MenuModeCount
    state "Modus Zeit\n(GAME_MODE_TIMED)" as MenuModeTimed
    state "Modus Rennen\n(GAME_MODE_RACE)" as MenuModeRace

    MenuModeCount -down-> MenuModeTimed : DOWN
    MenuModeTimed -down-> MenuModeRace : DOWN
    MenuModeRace --> MenuModeCount : DOWN

    MenuModeCount --> MenuModeRace : UP
    MenuModeRace --> MenuModeTimed : UP
    MenuModeTimed --> MenuModeCount : UP
}

MenuModeCount -right> ModeCount : RIGHT
MenuModeTimed -right> ModeTimed : RIGHT
MenuModeRace -right> ModeRace : RIGHT

ModeCount -left-> MenuModeCount : LEFT
ModeTimed -left-> MenuModeTimed : LEFT
ModeRace -left-> MenuModeRace : LEFT

@enduml
