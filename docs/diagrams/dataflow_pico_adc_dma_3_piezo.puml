@startuml
title
  <size:16><b>Schlagzähler Pico – ADC, FIFO, Ping-Pong DMA & Application Dataflow</b></size>
  <size:14><color:#555555>Version with three (3) piezos (Hardware Round-Robin DMA)</color></size>
end title

top to bottom direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 45

' ============================================================================
' 1. HARDWARE PERIPHERALS (RP2040)
' ============================================================================
package "RP2040 Hardware Peripherals" as HwLayer #Pink {
    component "Piezo Sensor 0\n(GPIO 26 / ADC0)" as Piezo0 #White
    component "Piezo Sensor 1\n(GPIO 27 / ADC1)" as Piezo1 #White
    component "Piezo Sensor 2\n(GPIO 28 / ADC2)" as Piezo2 #White

    component "RP2040 ADC\nHardware Round-Robin (mask 0x07)\nFree-Running @ 150 kHz aggregate\n(50 kHz per channel, 12-bit: 0..4095)" as AdcHw #White
    queue "ADC Hardware FIFO\n(4x 16-bit words)\nInterleaved: [S0, S1, S2, S0, S1...]\nDREQ_ADC asserted at >= 1 sample" as AdcFifo #White

    package "DMA Controller (Ping-Pong Chained)" as DmaHw #FFD6E0 {
        component "DMA Channel 0\n384 transfers x 16-bit\n(128 samples x 3 sensors)" as DmaChan0 #White
        component "DMA Channel 1\n384 transfers x 16-bit\n(128 samples x 3 sensors)" as DmaChan1 #White
    }
}

' ============================================================================
' 2. ABSTRACTION LAYER (DMA RAM BUFFERS & DRIVER)
' ============================================================================
package "Abstraction Layer (OSAL: PicoDma & PicoPiezoAdcDriver)" as AbsLayer #Cyan {
    database "s_buffer0[384]\n(2.56 ms window @ 150 kHz agg,\n128 samples / sensor, interleaved)" as Buf0 #White
    database "s_buffer1[384]\n(2.56 ms window @ 150 kHz agg,\n128 samples / sensor, interleaved)" as Buf1 #White

    component "PicoDma ISR\ndma_irq_handler()\nRe-arms completed channel" as PicoDmaIsr #FFEEEE
    component "PicoPiezoAdcDriver Callback\non_dma_buffer_complete()\ns_completed_index = 0 | 1\ns_has_new_buffer = true" as AdcDriverCb #FFEEEE
    component "PiezoAdcDriver_poll_buffer()\nReturns pointer to completed\ns_buffer0 or s_buffer1 (384 samples)" as PollBuffer #White
}

' ============================================================================
' 3. APPLICATION LAYER (CORE 0 & CORE 1)
' ============================================================================
package "Application Layer (Core 0 & Core 1)" as AppLayer #LightGray {
    component "HitDetector_process_buffer()\n1. De-interleave samples by sensor (i % 3)\n2. CALIBRATING: per-sensor baseline & noise\n3. ARMED: per-sensor dynamic threshold decay\n4. Coincidence Window\n5. Winner Disambiguation: max peak intensity\n6. Lockout" as HitDetector #White
    component "SignalCapture_process_samples()\nTarget-Selected Waveform Capture:\n• Target 0/1/2: 5:1 max-pool (10 kHz)\n• Target ALL: 15:1 max-pool interleaved (10 kHz)\n21,000 samples" as SignalCapture #White
    component "GameController_on_hit()\nAuthoritative aggregate game scoring\n(CountMode / TimedMode / RaceMode)" as GameController #White
    queue "OsalQueue\nqueue_core0_to_core1\n(Core0ToCore1Message)" as InterCoreQueue #White
    component "Core 1 Consumers\n• DisplayPresenter: Aggregate score UI\n• CompanionProtocol: USB Serial" as Core1Consumers #White
}

' ============================================================================
' DATAFLOW CONNECTIONS
' ============================================================================

' Analog to ADC to FIFO
Piezo0 -down-> AdcHw : Analog voltage 0
Piezo1 -down-> AdcHw : Analog voltage 1
Piezo2 -down-> AdcHw : Analog voltage 2
AdcHw -down-> AdcFifo : Interleaved 12-bit sample\nevery 6.67 µs (150 kHz aggregate)

' FIFO to DMA via DREQ_ADC
AdcFifo -down-> DmaChan0 : DREQ_ADC\n(&adc_hw->fifo)
AdcFifo -down-> DmaChan1 : DREQ_ADC\n(&adc_hw->fifo)

' Ping-Pong Chaining between DMA Channel 0 and Channel 1
DmaChan0 -right-> DmaChan1 : CHAIN_TO\n(when 384 samples done)
DmaChan1 -left-> DmaChan0 : CHAIN_TO\n(when 384 samples done)

' DMA writes to RAM buffers
DmaChan0 -down-> Buf0 : DMA Write\n(384 x uint16_t)
DmaChan1 -down-> Buf1 : DMA Write\n(384 x uint16_t)

' Hardware Interrupt Path in RED
DmaChan0 .[#Red]down.> PicoDmaIsr : <color:Red><b>DMA_IRQ_0</b></color>\n<color:Red>(Buffer 0 full)</color>
DmaChan1 .[#Red]down.> PicoDmaIsr : <color:Red><b>DMA_IRQ_0</b></color>\n<color:Red>(Buffer 1 full)</color>
PicoDmaIsr -[#Red]down-> AdcDriverCb : <color:Red><b>callback(buffer_index)</b></color>
AdcDriverCb .[#Red]down.> PollBuffer : <color:Red>Sets s_has_new_buffer = true</color>\n<color:Red>s_completed_index = 0 | 1</color>

' Zero-copy buffer pointer handoff to Core 0 loop
Buf0 -down-> PollBuffer : Zero-copy pointer\n(when index == 0)
Buf1 -down-> PollBuffer : Zero-copy pointer\n(when index == 1)

PollBuffer -down-> HitDetector : uint16_t* interleaved_samples\nsample_count = 384
HitDetector -right-> SignalCapture : Feed raw samples\nfor selected target(s)
HitDetector -down-> GameController : HitEvent\n(hit_id, winning sensor_id, peak, intensity)
HitDetector -down-> InterCoreQueue : MSG_CALIBRATION_RESULT (x3)\nMSG_CAPTURE_READY
GameController -down-> InterCoreQueue : MSG_HIT_DETECTED (with sensor_id)\nMSG_SCORE_CHANGED
InterCoreQueue -down-> Core1Consumers : Non-blocking pop\non Core 1

@enduml
